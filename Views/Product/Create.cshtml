@model SmartWarehouse.Entities.Product

<form asp-action="Create" method="post">

<div class="container mt-4">

    <div class="card shadow-sm">
        
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Yeni Ürün Ekle</h3>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label class="form-label fw-bold">Ürün Adı</label>
                <input asp-for="ProductName" class="form-control" placeholder="Ürün adını giriniz" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Fiyat</label>
                <input asp-for="Price" class="form-control" placeholder="Ürün fiyatını giriniz" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Stok</label>
                <input asp-for="Stock" class="form-control" placeholder="Stok miktarını giriniz" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Barkod</label>
                <input asp-for="Barcode" class="form-control" placeholder="Barkod numarasını giriniz" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Açıklama</label>
                <input asp-for="Description" class="form-control" placeholder="Ürün açıklamasını giriniz" />
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-success rounded-pill px-4">
                    Kaydet
                </button>
            </div>

        </div>

    </div>

</div>
</form>